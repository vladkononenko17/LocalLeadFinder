NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_OWNER_EMAIL=yomancat@gmail.com
OSM_USER_AGENT=LocalLeadFinder/0.1 (yomancat@gmail.com)
# Google Places API (New): включите Places API (New) в Google Cloud и ограничьте ключ по API
GOOGLE_MAPS_API_KEY=
# Сколько платных запросов Text Search можно сделать за один поиск (Enterprise SKU)
GOOGLE_MAX_REQUESTS=40
# Жёсткий месячный лимит (бесплатная квота — 1000, в SQL зашит потолок 1000). При исчерпании поиск идёт только по OSM
GOOGLE_MONTHLY_CAP=950
